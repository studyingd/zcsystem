# zcsystem 环境变量模板
# 用法：cp .env.example .env 后填写实际值。
# .env 含密钥，.gitignore 已忽略、不会入库；本模板只含占位说明，可安全提交。
#
# 约定：列出值的变量为必填；「#变量=默认值」形式的可选项保持注释状态即生效默认值，
# 需要覆盖时取消注释改值（留空字符串会覆盖掉代码里的默认值，反而弄坏功能）。

# ---------- 数据库（必填） ----------
# 容器部署时 DB_HOST 必须写「容器可直达」的地址（内网 IP / 域名 / compose 服务名）；
# localhost 在容器内指向容器自身，永远连不上库。手工 docker run 同理。
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# 连接池容量（默认 8；每进程独立，需 ≥ gunicorn 单进程线程数 WEB_THREADS）
#DB_POOL_SIZE=8

# ---------- S3 兼容对象存储（必填，附件上传） ----------
S3_ENDPOINT=http://对象存储地址:9001
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 附件外链前缀：浏览器可访问的地址；内外网地址一致时省略（默认同 S3_ENDPOINT）
#S3_EXTERNAL_URL=http://外部访问地址:9001
# 附件存储桶名（默认 zcsystem）
#S3_BUCKET=zcsystem

# ---------- Flask（必填） ----------
# 会话签名密钥，生成：openssl rand -hex 32；泄露等于可伪造任意登录会话
SECRET_KEY=

# HTTPS 部署时设 1（默认 0），禁止会话 cookie 走明文信道
#SESSION_COOKIE_SECURE=1

# ---------- 飞书多维表（可选：看板「申请数量」实时取值） ----------
# 以下全部留空/不配置 = 不启用飞书集成，申请数量显示为空，其余功能不受影响。
# 需要自建应用具备「知识库/多维表格」只读权限。
#FEISHU_APP_ID=
#FEISHU_APP_SECRET=
# ★推荐：直接粘贴浏览器里的多维表格链接，自动解析节点与 table_id；
#   /wiki/、/base/、/bitable/ 三种链接都支持
#FEISHU_BITABLE_URL=https://<租户>.feishu.cn/wiki/xxxx?table=tblxxxx&view=vewxxxx
# 未配链接时的备选：wiki 节点 token（缺省 = 内置资产申请表节点）
#FEISHU_WIKI_TOKEN=
# 数据表 table_id：优先级高于链接里的 table 参数（缺省取第一张表）
#FEISHU_TABLE_ID=
# 申请数量缓存新鲜期秒数（默认 120）；过期由后台线程刷新，请求不等待
#FEISHU_CACHE_TTL=120
# 启动时后台预热飞书数据（默认 1 = 开启）
#FEISHU_WARMUP=1

# ---------- 开发服务器参数（可选，仅 run.py 入口生效） ----------
#HOST=0.0.0.0
#PORT=5000
# 调试器默认关闭；仅开发机需要调试器/热重载时设 1（生产切勿开启）
#FLASK_DEBUG=0
